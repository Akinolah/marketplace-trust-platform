# CognoDB connection details — from console.cognodb.com after provisioning your c0 instance.
# Copy this file to .env and fill in real values. Never commit .env.
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# Backend server
PORT=4000
HOST=0.0.0.0

# Comma-separated list of origins allowed to call this API (your deployed frontend + localhost)
CORS_ORIGINS=http://localhost:3000
